# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Project Settings, Environment Variables.
# With none of them set, the app runs in sample mode.

# Supabase: your project's address. Supabase, Project Settings, Data API (or the Connect button).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase: the public key, called publishable or anon. Safe in the browser, because RLS guards the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI, used by askAI() in lib/ai.ts. Which AI answers: gemini (default) or claude.
AI_PROVIDER=gemini
# Gemini key, free from Google AI Studio (aistudio.google.com). Leave empty to keep AI off.
GEMINI_API_KEY=
# Optional: a different Gemini model. Leave empty to use the one set in lib/ai.ts.
GEMINI_MODEL=
# Claude key from console.anthropic.com. Only used when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Optional: a different Claude model. Leave empty to use the one set in lib/ai.ts.
CLAUDE_MODEL=
